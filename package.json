{
  "name": "openclaw-plugin-vt-sentinel",
  "version": "0.12.3",
  "displayName": "VT Sentinel",
  "description": "VirusTotal Sentinel for OpenClaw — malware detection, active protection, and AI-powered code analysis for OpenClaw agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "king-tero",
  "homepage": "https://github.com/king-tero/VT-sentinel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/king-tero/VT-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/king-tero/VT-sentinel/issues"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/signatures','dist/signatures',{recursive:true})\"",
    "watch": "tsc -w",
    "test": "node dist/test_runner.js",
    "scan": "node dist/self-scan.js",
    "scan:json": "node dist/self-scan.js --json",
    "prescan": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "plugin",
    "security",
    "virustotal",
    "malware",
    "antivirus",
    "code-insight",
    "file-scanner",
    "threat-detection"
  ],
  "license": "MIT",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "dist/index.*",
    "dist/scanner.*",
    "dist/vt-api.*",
    "dist/vt-credentials.*",
    "dist/classifier.*",
    "dist/cache.*",
    "dist/path-extractor.*",
    "dist/audit-log.*",
    "dist/config-manager.*",
    "dist/state-store.*",
    "dist/status-renderer.*",
    "dist/env-access.*",
    "dist/version.*",
    "dist/update-commands.*",
    "dist/compliance-snapshot.*",
    "dist/signatures/**/*.json",
    "skills/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "minHostVersion": ">=2026.3.22"
    },
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": ">=2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.4.12"
    }
  },
  "dependencies": {
    "axios": "^1.15.0",
    "chokidar": "^3.5.3",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
